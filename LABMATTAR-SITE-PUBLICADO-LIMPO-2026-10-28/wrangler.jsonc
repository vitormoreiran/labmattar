{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mattar-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/editar*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "mattar-editor",
    "database_id": "f93a0632-659c-4595-8ecf-b83bcb2565a6"
  }]
}
