    "textContrast": {
      "status": "adjustable-implementation",
      "trigger": "visible text overlaps photographic area",
      "veilColor": "#000000",
      "legacyDefaultOpacity": 0.2,
      "rangePercent": [
        0,
        80
      ],
      "presetsPercent": [
        0,
        20,
        40,
        60
      ],
      "targets": [
        "photographic background",
        "image clipped by M",
        "unmasked image"
      ],
      "otherwise": "no automatic veil",
      "approval": "Evaluate legibility at final size; preset values are not automatic approval.",
      "notes": "Intensity belongs to the image, follows clipping, survives project round trips and is shared by pages in a section. Existing projects retain 20%."
    }
