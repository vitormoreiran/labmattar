{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mattar-portfolio",
  "main": "worker/entry.mjs",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": [
      "/",
      "/api/*",
      "/editar*",
      "/laboratorio",
      "/laboratorio/",
      "/inicio",
      "/inicio.html",
      "/inicio/",
      "/manual",
      "/manual.html",
      "/manual/",
      "/motion",
      "/motion.html",
      "/motion/",
      "/tipografia",
      "/tipografia.html",
      "/tipografia/",
      "/cores",
      "/cores.html",
      "/cores/",
      "/composicao",
      "/composicao.html",
      "/composicao/",
      "/laboratorio.html",
      "/compor",
      "/compor.html",
      "/compor/",
      "/identidade",
      "/identidade.html",
      "/identidade/",
      "/redes",
      "/redes.html",
      "/redes/",
      "/imagem",
      "/imagem.html",
      "/imagem/",
      "/assinatura-email",
      "/assinatura-email.html",
      "/assinatura-email/",
      "/montar",
      "/montar.html",
      "/montar/",
      "/aplicacoes-validadas",
      "/aplicacoes-validadas.html",
      "/aplicacoes-validadas/",
      "/validacao-identidade",
      "/validacao-identidade.html",
      "/validacao-identidade/",
      "/motion/matriz/index.html",
      "/motion/matriz/"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mattar-editor",
      "database_id": "f93a0632-659c-4595-8ecf-b83bcb2565a6"
    }
  ],
  "keep_vars": true
}
